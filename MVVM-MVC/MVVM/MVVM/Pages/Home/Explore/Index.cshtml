@page
@model MVVM.Pages.Home.Explore.IndexModel

@{
    ViewData["Title"] = "Explorar";
}

<link rel="stylesheet" href="~/css/home.css" />

<div class="container mt-4" style="max-width:700px;">

    <h2 class="mb-4">Explorar utilizadores</h2>

    <form method="get">

        <input type="text"
               name="Search"
               value="@Model.Search"
               class="form-control"
               placeholder="Pesquisar utilizadores..." />

    </form>

    <div class="mt-4">

        @if (!Model.Users.Any())
        {
            <p class="text-muted">
                Nenhum utilizador encontrado.
            </p>
        }
        else
        {
            @foreach (var user in Model.Users)
            {
                <a asp-page="/Profile/Index"
                   asp-route-id="@user.Id"
                   class="text-decoration-none text-dark">

                    <div class="card mb-3 shadow-sm">

                        <div class="card-body d-flex align-items-center gap-3">

                            <div class="avatar">
                                @user.UserName!.Substring(
                                    0,
                                    Math.Min(2, user.UserName.Length)
                                ).ToUpper()
                            </div>

                            <div>

                                <div class="fw-bold">
                                    @user.UserName
                                </div>

                                <div class="text-muted">
                                    @("@"+user.UserName)
                                </div>

                            </div>

                        </div>

                    </div>

                </a>
            }
        }

    </div>

</div>