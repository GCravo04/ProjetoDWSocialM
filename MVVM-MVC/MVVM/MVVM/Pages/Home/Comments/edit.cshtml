@page "{id:int}"
@model MVVM.Pages.Home.Comments.EditModel

@{
    ViewData["Title"] = "Editar Comentário";
}

<link rel="stylesheet" href="~/css/home.css"/>

<div class="container mt-5" style="max-width:700px;">

    <div class="card shadow-sm">

        <div class="card-header">
            <h3>Editar Comentário</h3>
        </div>

        <div class="card-body">

            <form method="post">

                <input asp-for="CommentId" type="hidden" />

                <input type="hidden"
                       name="PostId"
                       value="@Model.PostId" />

                <div class="mb-3">

                    <textarea asp-for="Content"
                              rows="4"
                              class="form-control">
                    </textarea>

                    <span asp-validation-for="Content"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a asp-page="/Home/Posts/Details"
                       asp-route-id="@Model.PostId"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-dark">
                        Guardar
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial"/>
}