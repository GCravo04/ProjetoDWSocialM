@page
@model MVVM.Pages.Home.IndexModel
@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="~/css/home.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="layout">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">nexo</div>

        <ul class="menu">
            <li><i class="bi bi-search"></i> Explorar</li>
            <li><i class="bi bi-person"></i> Perfil</li>
        </ul>

        <div class="profile-box">

            <div class="avatar">
                @Model.CurrentUser?.UserName?.Substring(0, Math.Min(2, Model.CurrentUser.UserName.Length)).ToUpper()
            </div>

            <div>
                <strong>@Model.CurrentUser?.UserName</strong><br />
                <small>@("@"+Model.CurrentUser?.UserName)</small>
            </div>

        </div>

    </aside>

    <!-- FEED -->

    <main class="feed">

        <div class="tabs">
            <div class="tab active">Para si</div>
            <div class="tab">A seguir</div>
        </div>

        <!-- NOVA PUBLICAÇÃO -->

        <div class="composer">

            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <a asp-page="/Home/Posts/Create"
                   class="create-post-link">

                    <div class="composer-top">

                        <div class="avatar">
                            @Model.CurrentUser?.UserName?.Substring(0, Math.Min(2, Model.CurrentUser.UserName.Length)).ToUpper()
                        </div>

                        <div class="fake-textarea">
                            O que se passa?
                        </div>

                    </div>

                </a>
            }
            else
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="create-post-link">

                    <div class="composer-top">

                        <div class="avatar">?</div>

                        <div class="fake-textarea">
                            Inicia sessão para publicar...
                        </div>

                    </div>

                </a>
            }

        </div>

        <!-- POSTS -->

        @foreach (var post in Model.Posts)
        {
            <div class="post">

                <div class="post-header">

                    <div class="avatar">
                        @post.User.UserName.Substring(0, Math.Min(2, post.User.UserName.Length)).ToUpper()
                    </div>

                    <div>

                        <span class="post-name">
                            @post.User.UserName
                        </span>

                        <span class="post-user">
                            @("@"+post.User.UserName)
                        </span>

                        <span class="post-time">
                            · @post.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </span>

                    </div>

                </div>

                <div class="post-content">
                    @post.Content
                </div>

                <div class="post-actions">

                    <span>
                        <i class="bi bi-chat"></i>
                        @post.Comments.Count
                    </span>

                    <form method="post"
                          asp-page-handler="Like"
                          class="d-inline">

                        <input type="hidden"
                               name="PostId"
                               value="@post.PostId" />

                        @{
                            var liked =
                                User.Identity?.IsAuthenticated == true &&
                                post.Likes.Any(l => l.UserId == Model.CurrentUser?.Id);
                        }

                        <button type="submit"
                                class="btn p-0 border-0 bg-transparent">

                            @if (liked)
                            {
                                <i class="bi bi-heart-fill text-danger"></i>
                            }
                            else
                            {
                                <i class="bi bi-heart"></i>
                            }

                            @post.Likes.Count

                        </button>

                    </form>

                </div>
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <form method="post" asp-page-handler="Comment">

                        <input type="hidden"
                               name="PostId"
                               value="@post.PostId" />

                        <input type="text"
                               name="CommentContent"
                               class="form-control mt-2"
                               placeholder="Escreve um comentário..." />

                        <button type="submit"
                                class="btn btn-dark mt-2">
                            Comentar
                        </button>

                    </form>
                }

            </div>
        }

    </main>

    <!-- SUGESTÕES -->

    <aside class="right">

        <div class="suggestions">

            <h5>Quem seguir</h5>

            <p class="text-muted">
                Funcionalidade em desenvolvimento.
            </p>

        </div>

    </aside>

</div>