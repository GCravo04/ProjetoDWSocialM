@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="~/css/home.css"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="layout">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">
            nexo
        </div>

        <ul class="menu">

            <li>
                <a asp-page="/Home/Index"
                   class="sidebar-link">
                    <i class="bi bi-house-door"></i>
                    Home
                </a>
            </li>

            <li>
                <a asp-page="/Home/Explore/Index"
                   class="sidebar-link">
                    <i class="bi bi-search"></i>
                    Explorar
                </a>
            </li>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <li>
                    <a asp-page="/Profile/Index"
                       asp-route-id="@Model.CurrentUser?.Id"
                       class="sidebar-link">
                        <i class="bi bi-person"></i>
                        Perfil
                    </a>
                </li>
            }

            <li>
                <a asp-page="/Details/Index"
                   class="sidebar-link">
                    <i class="bi bi-info-circle"></i>
                    Sobre
                </a>
            </li>

            @if (User.IsInRole("Admin"))
            {
                <li>
                    <a asp-page="/BackOffice/Users"
                       class="sidebar-link sidebar-admin">
                        <i class="bi bi-shield-lock"></i>
                        Administração
                    </a>
                </li>
            }

        </ul>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="profile-box">

                <div class="avatar">
                    @Model.CurrentUser?.UserName?.Substring(
                        0,
                        Math.Min(2, Model.CurrentUser.UserName.Length)
                    ).ToUpper()
                </div>

                <div>
                    <strong>@Model.CurrentUser?.UserName</strong><br />
                    <small>@("@"+Model.CurrentUser?.UserName)</small>
                </div>

            </div>
        }

    </aside>

    <!-- FEED -->

    <main class="feed">

        <div class="feed-tabs">

            <a asp-page="/Home/Index"
               asp-route-feed="all"
               class="feed-tab @(Model.CurrentFeed == "all" ? "active" : "")">
                Para si
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Home/Index"
                   asp-route-feed="following"
                   class="feed-tab @(Model.CurrentFeed == "following" ? "active" : "")">
                    A seguir
                </a>
            }
            else
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="feed-tab">
                    A seguir
                </a>
            }

        </div>

        <!-- NOVA PUBLICAÇÃO -->

        <div class="composer">

            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <a asp-page="/Home/Posts/Create"
                   class="create-post-link">

                    <div class="composer-top">

                        <div class="avatar">
                            @Model.CurrentUser?.UserName?.Substring(
                                0,
                                Math.Min(2, Model.CurrentUser.UserName.Length)
                            ).ToUpper()
                        </div>

                        <div class="fake-textarea">
                            O que se passa?
                        </div>

                    </div>

                </a>
            }
            else
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="create-post-link">

                    <div class="composer-top">

                        <div class="avatar">?</div>

                        <div class="fake-textarea">
                            Inicia sessão para publicar...
                        </div>

                    </div>

                </a>
            }

        </div>

        <!-- POSTS -->

        @foreach (var post in Model.Posts)
        {
            <div class="post">

                <div class="post-header">

                    <a asp-page="/Profile/Index"
                       asp-route-id="@post.UserId"
                       class="avatar"
                       style="text-decoration:none;color:inherit;">

                        @post.User.UserName.Substring(
                            0,
                            Math.Min(2, post.User.UserName.Length)
                        ).ToUpper()

                    </a>

                    <div>

                        <a asp-page="/Profile/Index"
                           asp-route-id="@post.UserId"
                           class="post-name"
                           style="text-decoration:none;color:inherit;">

                            @post.User.UserName

                        </a>

                        <span class="post-user">
                            @("@" + post.User.UserName)
                        </span>

                        <span class="post-time">
                            · @post.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </span>

                    </div>

                </div>

                <a asp-page="/Home/Posts/Details" asp-route-id="@post.PostId"
                   class="post-content" style="text-decoration:none; color:inherit; display:block; cursor:pointer;">
                    @post.Content
                </a>
                
                    <div class="post-actions">

                        <a asp-page="/Home/Posts/Details"
                           asp-route-id="@post.PostId"
                           style="text-decoration:none;color:inherit;">
                            <i class="bi bi-chat"></i>
                            @post.Comments.Count
                        </a>

                        @{
                            var liked =
                                User.Identity?.IsAuthenticated == true &&
                                post.Likes.Any(l => l.UserId == Model.CurrentUser?.Id);
                        }

                        <button type="button"
                                id="like-@post.PostId"
                                class="btn p-0 border-0 bg-transparent like-btn"
                                data-post="@post.PostId">

                            <i id="heart-@post.PostId"
                               class="bi @(liked ? "bi-heart-fill text-danger" : "bi-heart")">
                            </i>

                            <span class="like-count">@post.Likes.Count</span>
                        </button>

                    </div>
                    

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <form method="post"
                          asp-page="/Home/Comments/Create">

                        <input type="hidden"
                               name="PostId"
                               value="@post.PostId"/>

                        <div class="d-flex gap-2 mt-2">

                            <input type="text"
                                   name="CommentContent"
                                   class="form-control"
                                   placeholder="Escreve um comentário..." />

                            <button type="submit"
                                    class="btn btn-dark">
                                Comentar
                            </button>

                        </div>

                    </form>
                }

            </div>
        }

    </main>
</div>

@section Scripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script>

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/feedHub")
            .build();

        connection.on("LikeUpdated", function (postId, totalLikes, userId, liked) {

            const btn = document.getElementById("like-" + postId);

            if (!btn)
                return;

            btn.querySelector(".like-count").innerText = totalLikes;

            
            if (userId === "@Model.CurrentUser?.Id") {

                const heart = document.getElementById("heart-" + postId);

                if (liked) {
                    heart.classList.remove("bi-heart");
                    heart.classList.add("bi-heart-fill", "text-danger");
                }
                else {
                    heart.classList.remove("bi-heart-fill", "text-danger");
                    heart.classList.add("bi-heart");
                }
            }

        });

        connection.start()
            .then(() => console.log("Ligado ao SignalR"))
            .catch(err => console.error(err));

        document.querySelectorAll(".like-btn").forEach(btn => {

            btn.addEventListener("click", function () {

                const postId = this.dataset.post;

                connection.invoke("ToggleLike", parseInt(postId))
                    .catch(err => console.error(err));

            });

        });
        
    </script>
}