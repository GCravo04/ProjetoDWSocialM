@page
@model MVVM.Pages.Home.IndexModel
@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="~/css/home.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="layout">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">nexo</div>

        <ul class="menu">
            
            <li>
                <a asp-page="/Home/Explore/Index"
                   class="sidebar-link">
                    <i class="bi bi-search"></i>
                    Explorar
                </a>
            </li>
        </ul>

        <div class="profile-box">

            <div class="avatar">
                @Model.CurrentUser?.UserName?.Substring(
                    0,
                    Math.Min(2, Model.CurrentUser.UserName.Length)
                ).ToUpper()
            </div>

            <div>
                <strong>@Model.CurrentUser?.UserName</strong><br />
                <small>@("@"+Model.CurrentUser?.UserName)</small>
            </div>

        </div>

    </aside>

    <!-- FEED -->

    <main class="feed">
        
        <div class="feed-tabs">

            <a asp-page="/Home/Index"
               asp-route-feed="all"
               class="feed-tab @(Model.CurrentFeed == "all" ? "active" : "")">
                Para si
            </a>

            <a asp-page="/Home/Index"
               asp-route-feed="following"
               class="feed-tab @(Model.CurrentFeed == "following" ? "active" : "")">
                A seguir
            </a>

        </div>

        <!-- NOVA PUBLICAÇÃO -->

        <div class="composer">

            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <a asp-page="/Home/Posts/Create"
                   class="create-post-link">

                    <div class="composer-top">

                        <div class="avatar">
                            @Model.CurrentUser?.UserName?.Substring(
                                0,
                                Math.Min(2, Model.CurrentUser.UserName.Length)
                            ).ToUpper()
                        </div>

                        <div class="fake-textarea">
                            O que se passa?
                        </div>

                    </div>

                </a>
            }
            else
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="create-post-link">

                    <div class="composer-top">

                        <div class="avatar">?</div>

                        <div class="fake-textarea">
                            Inicia sessão para publicar...
                        </div>

                    </div>

                </a>
            }

        </div>

        <!-- POSTS -->

        @foreach (var post in Model.Posts)
        {
            <div class="post">

                <div class="post-header">

                    <a asp-page="/Profile/Index"
                       asp-route-id="@post.UserId"
                       class="avatar"
                       style="text-decoration:none;color:inherit;">

                        @post.User.UserName.Substring(
                            0,
                            Math.Min(2, post.User.UserName.Length)
                        ).ToUpper()

                    </a>

                    <div>

                        <a asp-page="/Profile/Index"
                           asp-route-id="@post.UserId"
                           class="post-name"
                           style="text-decoration:none;color:inherit;">

                            @post.User.UserName

                        </a>

                        <span class="post-user">
                            @("@" + post.User.UserName)
                        </span>

                        <span class="post-time">
                            · @post.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </span>

                    </div>

                </div>

                <a asp-page="/Home/Posts/Details" asp-route-id="@post.PostId"
                   class="post-content" style="text-decoration:none; color:inherit; display:block; cursor:pointer;">
                    @post.Content
                </a>

                <div class="post-actions">

                    <a asp-page="/Home/Posts/Details" asp-route-id="@post.PostId"
                       style="text-decoration:none; color:inherit;">
                        <i class="bi bi-chat"></i>
                        @post.Comments.Count
                    </a>

                    <form method="post"
                          asp-page="/Home/Likes/Toggle"
                          class="d-inline">

                        <input type="hidden"
                               name="PostId"
                               value="@post.PostId"/>

                        @{
                            var liked =
                                User.Identity?.IsAuthenticated == true &&
                                post.Likes.Any(
                                    l => l.UserId == Model.CurrentUser?.Id
                                );
                        }

                        <button type="submit"
                                class="btn p-0 border-0 bg-transparent">

                            @if (liked)
                            {
                                <i class="bi bi-heart-fill text-danger"></i>
                            }
                            else
                            {
                                <i class="bi bi-heart"></i>
                            }

                            @post.Likes.Count

                        </button>

                    </form>

                </div>

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <form method="post"
                          asp-page="/Home/Comments/Create">

                        <input type="hidden"
                               name="PostId"
                               value="@post.PostId"/>

                        <input type="text"
                               name="CommentContent"
                               class="form-control mt-2"
                               placeholder="Escreve um comentário..."/>

                        <button type="submit"
                                class="btn btn-dark mt-2">
                            Comentar
                        </button>

                    </form>
                }

            </div>
        }

    </main>
</div>