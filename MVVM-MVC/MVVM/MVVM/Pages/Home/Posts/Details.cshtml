@page
@model DetailsModel

@{
    ViewData["Title"] = "Detalhes da Publicação";
}

<link rel="stylesheet" href="~/css/home.css"/>

<div class="container mt-5" style="max-width:700px;">

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="border rounded p-3 mb-3">

                <div class="mb-2">
                    <strong>@Model.Post.User.UserName</strong>
                    <small class="text-muted">
                        · @Model.Post.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </small>
                </div>

                <div class="mb-3">
                    <textarea class="form-control"
                              rows="4"
                              readonly>@Model.Post.Content</textarea>
                </div>

                <div class="text-muted mb-3">
                    <i class="bi bi-heart"></i> @Model.Post.Likes.Count gostos
                    &nbsp;·&nbsp;
                    <i class="bi bi-chat"></i> @Model.Post.Comments.Count comentários
                </div>

                @if (Model.Post.Comments.Any())
                {
                    <div class="mt-3">

                        <h6>Comentários (@Model.Post.Comments.Count)</h6>

                        @foreach (var comment in Model.Post.Comments.OrderBy(c => c.CreatedAt))
                        {
                            <div class="border rounded p-2 mb-2">
                                <div class="mb-1">
                                    <strong>@comment.User.UserName</strong>
                                    <small class="text-muted">
                                        · @comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </div>
                                <div>@comment.Content</div>
                            </div>
                            
                            @if (User.Identity?.IsAuthenticated == true &&
                                 (comment.UserId == Model.CurrentUser?.Id || User.IsInRole("Admin")))
                            {
                                <form method="post" asp-page="/Home/Comments/Delete" class="mt-2">
                                    <input type="hidden" name="CommentId" value="@comment.CommentId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Eliminar
                                    </button>
                                </form>
                            }
                        }

                    </div>
                }
                else
                {
                    <p class="text-muted">Sem comentários.</p>
                }

            </div>

            <div class="d-flex justify-content-end">
                <a asp-page="/Home/Index" class="btn btn-secondary">Voltar</a>
            </div>

        </div>

    </div>

</div>