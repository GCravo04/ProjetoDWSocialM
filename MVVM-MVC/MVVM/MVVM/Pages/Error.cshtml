@page "/Error/{code:int?}"
@model MVVM.Pages.ErrorModel
@{
    ViewData["Title"] = Model.Titulo;
}

<div class="container text-center" style="max-width: 520px; margin-top: 80px;">
    <div style="font-size: 72px; font-weight: 700; color: #0d6efd;">@Model.StatusCode</div>
    <h1 class="h3 mt-2">@Model.Titulo</h1>
    <p class="text-muted">@Model.Mensagem</p>
    <a asp-page="/Home/Index" class="btn btn-primary rounded-pill px-4 mt-3">Voltar ao início</a>
</div>