@page "/Error/{code:int?}"
@model MVVM.Pages.ErrorModel
@{
    ViewData["Title"] = Model.Titulo;
}

<div class="container text-center" style="max-width: 520px; margin-top: 90px;">
    <div style="font-size: 80px; font-weight: 700; color: #111827; line-height: 1;">@Model.StatusCode</div>
    <h1 style="font-size: 22px; font-weight: 600; color: #111827; margin-top: 12px;">@Model.Titulo</h1>
    <p style="color: #6b7280; font-size: 15px;">@Model.Mensagem</p>
    <a asp-page="/Home/Index"
       style="display: inline-block; margin-top: 16px; padding: 10px 26px; background: #111827; color: white; border-radius: 999px; text-decoration: none; font-size: 15px;">
        Voltar ao início
    </a>
</div>